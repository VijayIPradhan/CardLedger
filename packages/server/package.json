{
  "name": "@cardledger/server",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test": "dotenv -e ../../.env -- vitest run --reporter=verbose",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate:pg",
    "db:migrate": "dotenv -e ../../.env -- tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@cardledger/shared": "workspace:*",
    "fastify": "^4.26.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "fastify-plugin": "^4.5.0",
    "drizzle-orm": "^0.30.0",
    "pg": "^8.11.0",
    "argon2": "^0.31.0",
    "zod": "^3.22.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "dotenv-cli": "^7.4.0"
  }
}
